{
  "name": "@boxhaven/backend",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:api": "tsx src/index.ts",
    "dev:app": "vite --host 0.0.0.0 --port 5173",
    "start": "node dist/index.js",
    "build": "rm -rf dist && tsc -p tsconfig.json && npm run app:build",
    "app:build": "vite build",
    "smoke:console": "tsx scripts/console-smoke.mjs",
    "smoke:hosted-legal": "tsx scripts/hosted-legal-smoke.mjs",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "better-auth": "~1.6.13",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.11.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.7",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.16.0",
    "playwright-core": "^1.57.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.1.4"
  }
}
